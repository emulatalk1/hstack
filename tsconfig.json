    "tests/brainstorm-texts.test.ts",
    "tests/brainstorm-script.test.ts",
    "tests/brainstorm-edges.test.ts",
    "tests/script-call-and-dir-rule.test.ts",
    "tests/script-call-edges.test.ts",
    "tests/turn-reference.test.ts",
    "tests/turn-reference-texts.test.ts",
    "tests/turn-reference-edges.test.ts",
    "tests/no-stash-script.test.ts",
    "tests/no-stash-texts.test.ts",
    "tests/no-stash-edges.test.ts"
