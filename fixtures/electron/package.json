{
  "name": "hstack-electron-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "PROBE_DATA_DIR=data electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --dir",
    "mutate": "stryker run",
    "mutate:e2e": "stryker run stryker.e2e.config.json"
  },
  "build": {
    "appId": "dev.hstack.probe",
    "productName": "Probe",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
